{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "@legado/source-core": ["../../packages/source-core/src/index.ts"],
      "@legado/source-node": ["../../packages/source-node/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "rsbuild.config.ts", "server.ts", "env.d.ts"],
  "exclude": ["dist", "node_modules"]
}
