{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "paths": {
      "@legado/source-core": ["../../packages/source-core/dist/public/index.d.ts"],
      "@legado/source-node": ["../../packages/source-node/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["tests/**"]
}
