        "searchUrl": "@js:\nvar b = 'https://www.szndz.com';\nvar kw = String(key);\nvar sp = b + '/user/search.html?q=' + java.encodeURI(kw);\nvar h = '' + java.ajax(sp);\nvar names = ['vw','abw','ru','jrt','van','fw','cwl','gpr','uyoo','tz','euu','tsn','eju','um','fp','dvm','jpk','deblkx','ht','azy','sna','wqx','fpp','rup','jwj','bgt','qp','yf','cw','wq','sign'];\nvar parts = ['q=' + java.encodeURI(kw)];\nfor (var i = 0; i < names.length; i++) {\n var n = names[i];\n var mk = 'var ' + n;\n var v = '';\n var from = 0;\n var i1 = -1;\n while (true) {\n var i0 = h.indexOf(mk, from);\n if (i0 < 0) break;\n var pe = i0 + mk.length;\n while (pe < h.length && (h.charAt(pe) == ' ' || h.charAt(pe) == '\\t')) pe++;\n if (h.charAt(pe) == '=') { i1 = pe; break; }\n from = i0 + 1;\n }\n if (i1 >= 0) {\n var q1 = h.indexOf('\"', i1);\n var q2 = h.indexOf('\"', q1 + 1);\n v = h.substring(q1 + 1, q2);\n }\n if (n == 'bgt' && v.length > 0) v = v.substring(0, v.length - 1);\n parts.push(n + '=' + java.encodeURI(v));\n}\nb + '/api/search,{\"method\":\"POST\",\"body\":\"' + parts.join('&') + '\"}'",
