        "bookSourceName": "BookType 状态位流程",
        "mainJs": "function search(key,page){return [{name:'状态书',bookUrl:baseUrl+'/book',type:8}]}\nfunction explore(url,page){return [{name:'发现书',bookUrl:baseUrl+'/found',type:8}]}\nfunction getBookInfo(book){if(book.type!==1816)throw new Error('detail BookType: '+book.type);return {intro:String(book.type),type:book.type,tocUrl:book.bookUrl}}\nfunction getChapters(book){if(book.type!==1816)throw new Error('toc BookType: '+book.type);return [{title:String(book.type),url:baseUrl+'/chapter/1'},{title:'下一章',url:baseUrl+'/chapter/2'}]}\nfunction getContent(chapter,book,nextChapterUrl){if(book.type!==1816)throw new Error('content BookType: '+book.type);return book.type+'|'+chapter.title+'|'+nextChapterUrl}"
