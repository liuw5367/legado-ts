    "id": "date-bridge.quoted-and-unclosed-literal",
    "family": "date-bridge",
    "operation": "rule.dateBridge",
    "input": {
      "locale": "en-US",
      "timeZone": "UTC",
      "program": "function capture(pattern) { try { return {caught:false, value:java.timeFormatUTC(0, pattern, 0)}; } catch (error) { return {caught:true, continued:java.timeFormatUTC(0, 'yyyy', 0)}; } } return {quoted:java.timeFormatUTC(0, \"yyyy-MM-dd 'at' HH 'o''clock' ''\", 0), unclosed:capture(\"yyyy-MM-dd 'open\")};"
    },
    "reference": {
      "kind": "upstream-original",
      "method": "JsExtensions.timeFormatUTC(SimpleDateFormat quote parsing)"
    },
    "tags": ["edge", "quote", "literal"],
    "expected": {"outcome":"return","value":{"quoted":"1970-01-01 at 00 o'clock '","unclosed":{"caught":true,"continued":"1970"}}}
  },
