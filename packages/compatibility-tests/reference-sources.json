  "adaptations": [
    "ScriptBindings.kt 保持原样，测试适配只提供 RhinoScriptEngine.initialize 空入口。纯 JVM 直接配置 Rhino Context，按 BaseSource 和 SharedJsScope 的调用顺序验证内存状态，不覆盖应用缓存与调度。",
    {
      "file": "jvm/src/main/kotlin/androidx/annotation/Keep.kt",
      "reason": "构建期注解，无 Android 运行行为"
    },
    {
      "file": "jvm/src/main/kotlin/io/legado/app/utils/Debug.kt",
      "reason": "原函数异常处理保持原样，调试日志仅输出 stderr，不污染 JSON 结果协议"
    },
    {
      "file": "jvm/src/main/kotlin/android/text/TextUtils.kt",
      "reason": "仅提供 XPath getString 所需的 Iterable join；保持顺序、分隔符、null/toString 语义，独立测试；不引入 Android 运行库"
    },
    {
      "file": "scripts/prepare-jvm.mjs",
      "reason": "从校验过原文件摘要的 StringUtils 和 JsExtensions 提取纯章节数字方法，函数体原样编译。"
    },
    {
      "file": "reference-sources.json",
      "reason": "ICU CharsetDetector 原样保留字节与普通 InputStream 检测。排除只接受 Android ParcelFileDescriptor 的重载，非空注解用同包无行为声明替代。"
    },
    {
      "file": "jvm/src/main/kotlin/io/legado/app/utils/EncoderUtils.kt",
      "reason": "SymmetricCryptoAndroid 的 Android Base64.NO_WRAP 使用等价的 JDK Base64 encoder；参考端保留原类和上游 Hutool 版本。"
    }
  ],
